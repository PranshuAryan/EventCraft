{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm -w client run build",
  "outputDirectory": "client/dist",
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "server/data/**" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
