{
  "name": "eventcraft",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:server": "npm -w server run dev",
    "dev:client": "npm -w client run dev",
    "test": "npm -w server test && npm -w client test"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5"
  },
  "type": "module"
}